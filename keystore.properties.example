# Copia este archivo a "keystore.properties" (NO lo subas a Git) y rellena los datos.
# Android Studio / Gradle lo usan automaticamente para firmar la version release.
#
# Generar keystore:
#   keytool -genkeypair -v -keystore gis-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10950 -alias gis_supermercados
storeFile=gis-release.jks
storePassword=CAMBIAR_PASSWORD
keyAlias=gis_supermercados
keyPassword=CAMBIAR_PASSWORD
